# true: 실제 API / false: 같은 화면에 목데이터 사용 (백엔드 불필요).
# 변경 후 개발 서버를 다시 시작하세요. 배포 시에는 다시 빌드하세요.
VITE_USE_API=true

# 비워 두면 /api 사용. 로컬에서는 Vite가 개발 프록시 대상으로 전달합니다.
VITE_API_BASE_URL=

# API v1과 레거시 API의 개발 프록시 대상.
VITE_DEV_API_TARGET=http://localhost:8010

# 로컬 테스트 로그인 사용 (백엔드 AUTH_DEV_LOGIN=true 필요).
VITE_DEV_LOGIN=true

# 테스트용 내 계정 초기화 버튼. 백엔드 DEBUG_MODE=true도 필요하다.
VITE_DEBUG_MODE=false
